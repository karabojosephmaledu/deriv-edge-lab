# Deriv Edge Lab — backend configuration template. Copy to a private .env (or set in
# your host's dashboard, e.g. Render "Environment"). Never commit real values.

# MongoDB connection string (MongoDB Atlas "mongodb+srv://..." works)
MONGO_URL=
# Database name
DB_NAME=deriv_edge_lab
# Allowed browser origins, comma-separated (e.g. https://deriv-edge-lab-web.onrender.com)
CORS_ORIGINS=
# Your registered Deriv App ID (redirect URL: <your-site>/api/deriv/callback)
DERIV_APP_ID=
# Explicit opt-in for actual Deriv Demo orders. Live accounts always remain blocked.
DERIV_DEMO_TRADING_ENABLED=false
