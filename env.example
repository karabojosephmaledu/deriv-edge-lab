# Deriv Edge Lab — configuration template for Codex / independent hosting
# Copy this to a private .env file when deploying. Never commit actual secrets.

# Emergent AI coach (optional; may be removed/replaced)
EMERGENT_LLM_KEY=

# Public address of the running app; replace when deploying outside Emergent
APP_URL=https://deriv-edge-lab--3mg3a37k.preview.emergentagent.com

# Deriv application identifier — enter your registered app ID privately
DERIV_APP_ID=

# Owner-only administration gate — set your correct verified Deriv nickname privately
OWNER_NICKNAME=

# Backend database connection — set in hosting secrets if the code requires it
MONGO_URL=

# Mongo database name and allowed browser origins (comma-separated)
DB_NAME=
CORS_ORIGINS=
