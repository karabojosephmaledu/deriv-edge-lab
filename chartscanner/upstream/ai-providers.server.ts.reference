/**
 * EazyXPro AI provider engine.
 *
 * This keeps the new Admin UI, but restores the original reliable request path:
 * build the scanner prompt in /api/analyze, send multimodal AI SDK messages to an
 * OpenAI-compatible provider, parse the text response, then persist the result.
 */
import { createOpenAICompatible } from "@ai-sdk/openai-compatible";
import { generateText, type ModelMessage } from "ai";

export type ProviderId =
  | "bedrock"
  | "openrouter"
  | "gemini"
  | "vertex"
  | "claude"
  | "openai"
  | "deepseek"
  | "grok"
  | "replicate"
  | "together"
  | "edenai"
  | "poe"
  | "perplexity"
  | "mistral"
  | "groq"
  | "azure-openai"
  | "qwen"
  | "llama"
  | "openai-compatible";

type ProviderStyle = "openai-compatible" | "bedrock" | "replicate" | "edenai";

/** What the caller is asking the AI to do. The engine picks the model from this. */
export type AiTask = "auto" | "vision" | "reasoning" | "document" | "fast";

export interface ModelMeta {
  id: string;
  label: string;
  stars: number;
  speed: "Fast" | "Balanced" | "Slower";
  reasoning: "Basic" | "Strong" | "Highest";
  usage: string;
}

export interface ProviderDefinition {
  id: ProviderId;
  label: string;
  baseURL: string;
  defaultModel: string;
  envKeys: string[];
  docs: string;
  costPerMillion: { input: number; output: number };
  requiresBaseUrl?: boolean;
  apiStyle?: ProviderStyle;
  discoveryPath?: string;
  productionModels?: string[];
  /** Only visible providers are shown in the Admin UI. */
  visible?: boolean;
  /** Model chosen automatically per task. */
  taskModels?: Partial<Record<Exclude<AiTask, "auto">, string>>;
  modelMeta?: ModelMeta[];
}

